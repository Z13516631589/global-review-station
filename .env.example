# ---------------------------------------------------------------------------
# 消息面 LLM 分析（可选）
# 不配置任何变量也能正常运行：fetch_news.py 会自动回退规则词典分析。
# 推荐免费额度：Google Gemini（OpenAI 兼容端点）
# ---------------------------------------------------------------------------

# 兼容 OpenAI 的 API Base，例如：
#   Gemini:   https://generativelanguage.googleapis.com/v1beta/openai
#   DeepSeek: https://api.deepseek.com/v1
#   通义:     https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_API_BASE=

# API Key
LLM_API_KEY=

# 模型名（默认 gemini-2.0-flash）
LLM_MODEL=gemini-2.0-flash

# 设为 1 可强制关闭 LLM，只用规则兜底
DISABLE_LLM=0

# ---------------------------------------------------------------------------
# 抓取参数
# ---------------------------------------------------------------------------

# 单次最多保留的消息条数
NEWS_MAX_ITEMS=40

# 单次运行最多调用 LLM 的次数（控制配额）
NEWS_LLM_MAX_CALLS=20

# 自定义 RSS 源，逗号分隔；留空使用默认值
NEWS_RSS=

# 更新批次：A股收盘 / 美股收盘 / 盘前消息
FETCH_BATCH=A股收盘

# 指定 Python 可执行文件（npm run fetch 用）
# FETCH_PY=C:\Path\To\python.exe

# 构建期站点地址（生成绝对链接用）
# SITE_URL=https://your-domain.com
