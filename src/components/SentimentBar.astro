---
import { ashare } from '../lib/data';
import { sentimentColor } from '../lib/format';

interface Props {
  compact?: boolean;
}
const { compact = false } = Astro.props;

const s = ashare.sentiment;
const score = Math.max(0, Math.min(100, s.score ?? 50));
const color = sentimentColor(score);
const empty = !s.score && (s.label === '无数据' || !ashare.indices.length);
---

<section class="panel-pad">
  <div class="sec-head">
    <span class="bar"></span>
    <span class="title">情绪分</span>
    <span class="meta">0 冰点 · 100 过热</span>
  </div>

  {
    empty ? (
      <p class="note-info mt-4">
        尚无数据。情绪分由脚本根据真实盘面（涨跌家数 / 涨停跌停 / 量能）按可解释规则计算，运行 npm run fetch 后生成。
      </p>
    ) : (
      <>
        <div class:list={['flex items-end gap-4', compact ? 'mt-3' : 'mt-4']}>
          <div class:list={['num font-semibold leading-none', compact ? 'text-num-lg' : 'text-num-xl']} style={`color:${color}`}>
            {score}
          </div>
          <div class="pb-1">
            <div class="text-sm font-medium text-slate-200">{s.label}</div>
            {s.desc && <div class="mt-0.5 text-[13px] leading-6 text-muted">{s.desc}</div>}
          </div>
        </div>

        <div class:list={['bar-track', compact ? 'mt-3' : 'mt-4']}>
          <div
            class="bar-fill"
            style={`width:${score}%;background:linear-gradient(90deg,#12b981,#f5c451,#f2385a);background-size:${(100 / Math.max(score, 1)) * 100}% 100%;`}
          />
        </div>

        {!compact && s.drivers && s.drivers.length > 0 && (
          <ul class="mt-4 space-y-1.5">
            {s.drivers.map((d) => (
              <li class="flex gap-2 text-[13px] leading-6 text-slate-300">
                <span class="mt-2 h-1 w-1 shrink-0 rounded-full bg-accent" />
                <span>{d}</span>
              </li>
            ))}
          </ul>
        )}
      </>
    )
  }
</section>
