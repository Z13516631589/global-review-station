---
interface Pick {
  code: string;
  name: string;
  buy?: string;
  stop?: string;
  position?: string;
  logic?: string;
  status?: string;
}

interface Props {
  picks: Pick[];
  title?: string;
  note?: string;
}
const { picks, title = '标的观察', note } = Astro.props;

const statusChip = (s: string) => {
  if (s.includes('止损') || s.includes('离场') || s.includes('失败')) return 'chip-down';
  if (s.includes('兑现') || s.includes('达成') || s.includes('成功')) return 'chip-up';
  return 'chip-flat';
};
---

<section class="panel-pad">
  <div class="flex items-baseline justify-between gap-2">
    <h2 class="h-sec">{title}</h2>
    <span class="label">{picks.length} 只</span>
  </div>

  {
    note && (
      <p class="mt-3 rounded-lg border border-ink-400 bg-ink-600/50 px-3 py-2 text-[12px] leading-5 text-muted">
        {note}
      </p>
    )
  }

  {
    picks.length === 0 ? (
      <p class="py-6 text-center text-[13px] text-muted">本期无观察标的</p>
    ) : (
      <div class="mt-4 overflow-x-auto">
        <table class="w-full min-w-[720px] text-sm">
          <thead>
            <tr class="border-b border-ink-400 text-left text-[12px] text-muted">
              <th class="pb-2 font-medium">标的</th>
              <th class="pb-2 font-medium">观察买点</th>
              <th class="pb-2 font-medium">止损位</th>
              <th class="pb-2 font-medium">仓位上限</th>
              <th class="pb-2 font-medium">逻辑（客观记录）</th>
              <th class="pb-2 font-medium">跟踪状态</th>
            </tr>
          </thead>
          <tbody>
            {
              picks.map((p) => (
                <tr class="border-b border-ink-500/60 last:border-0 hover:bg-ink-600/40">
                  <td class="py-3">
                    <div class="text-slate-200">{p.name}</div>
                    <div class="num text-[11px] text-muted">{p.code}</div>
                  </td>
                  <td class="num py-3 text-slate-300">{p.buy || '—'}</td>
                  <td class="num py-3 text-down">{p.stop || '—'}</td>
                  <td class="num py-3 text-slate-300">{p.position || '—'}</td>
                  <td class="py-3 pr-3 text-[13px] leading-6 text-slate-300">{p.logic || '—'}</td>
                  <td class="py-3">
                    <span class:list={[statusChip(p.status || '观察中')]}>{p.status || '观察中'}</span>
                  </td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
    )
  }

  <p class="mt-4 text-[12px] leading-5 text-muted">
    表中仅为复盘记录中的客观挂单条件与跟踪状态，用于事后检验，不构成投资建议。
  </p>
</section>
