---
import Freshness from './Freshness.astro';
import { globalSnapshot } from '../lib/data';
import { fmtNum, fmtPct, fmtSigned, dirClass, dirChip } from '../lib/format';

interface Props {
  /** 首页只展示前几组，全球页展示全部 */
  limitGroups?: number;
  title?: string;
}
const { limitGroups, title = '全球市场快照' } = Astro.props;

const data = globalSnapshot;
const groups = limitGroups ? data.groups.slice(0, limitGroups) : data.groups;
---

<section class="panel-pad">
  <div class="sec-head">
    <span class="bar"></span>
    <span class="title">{title}</span>
    <div class="meta flex items-center gap-2">
      <span class="chip">{data.batch}</span>
      <span class="label">抓取于 <Freshness iso={data.updatedAt} /></span>
    </div>
  </div>

  {
    (data.stale || groups.length === 0) && (
      <p class="note-warn mt-4">
        {data.stale && groups.length > 0
          ? '以下为上一版缓存数据，可能已过期。'
          : '暂无真实数据。运行 npm run fetch 抓取最新延迟数据（或等待 GitHub Actions 定时更新）。本站不展示任何虚构行情。'}
      </p>
    )
  }

  {
    groups.length === 0 ? (
      <p class="py-6 text-center text-[13px] text-muted">暂无全球市场数据</p>
    ) : (
      <div class="mt-4 grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {groups.map((g) => (
          <div class="panel lift flex flex-col p-4">
            <div class="mb-2 flex items-center justify-between border-b border-line/60 pb-2">
              <span class="text-[13px] font-semibold text-slate-100">{g.market}</span>
              {g.currency && <span class="label">{g.currency}</span>}
            </div>
            <div class="flex flex-col">
              {g.items.map((q) => (
                <div class="flex items-center justify-between gap-3 border-b border-line/30 py-2 last:border-0">
                  <div class="min-w-0 flex-1">
                    <div class="flex items-center gap-1.5">
                      <span class="truncate text-[13px] font-medium text-slate-200" title={q.name}>
                        {q.name}
                      </span>
                      <span class="shrink-0 text-[10px] text-muted">{q.symbol}</span>
                      {q.asOf && (
                        <span class="shrink-0 text-[10px] text-muted">· 截至 {q.asOf.slice(5)}</span>
                      )}
                    </div>
                  </div>
                  <div class="shrink-0 text-right">
                    <div class="num text-[14px] font-semibold leading-tight text-slate-100">
                      {fmtNum(q.price)}
                    </div>
                    <div class="mt-0.5 flex items-center justify-end gap-1.5">
                      <span class:list={['delta', dirClass(q.changePct)]}>
                        {fmtSigned(q.change)}
                      </span>
                      <span class:list={[dirChip(q.changePct), 'num px-1.5 py-0 text-[10px]']}>
                        {fmtPct(q.changePct)}
                      </span>
                    </div>
                  </div>
                </div>
              ))}
            </div>
          </div>
        ))}
      </div>
    )
  }

  <p class="mt-4 text-[12px] leading-5 text-muted">
    口径说明：全球指数为上一交易日收盘（延迟数据）；美股交易日对应北京时间次日凌晨。
    每行价格下方的「截至 MM-DD」是该笔数据对应的交易日，请注意与抓取时间区分。
  </p>

  {
    data.note && data.note.includes('注意') && (
      <p class="note-warn mt-2">{data.note}</p>
    )
  }
</section>
