---
interface Record {
  total: number;
  win: number;
  loss: number;
  avgReturn: number;
  note?: string;
}

interface Props {
  record?: Record;
  title?: string;
}
const { record, title = '历史战绩' } = Astro.props;

const r = record ?? { total: 0, win: 0, loss: 0, avgReturn: 0, note: '' };
const rate = r.total > 0 ? (r.win / r.total) * 100 : 0;
const pending = Math.max(r.total - r.win - r.loss, 0);
const avgCls = r.avgReturn >= 0 ? 'text-up' : 'text-down';
---

<section class="panel-pad">
  <div class="sec-head">
    <span class="bar"></span>
    <span class="title">{title}</span>
    <span class="meta">客观命中率统计</span>
  </div>

  {
    r.total === 0 ? (
      <p class="py-6 text-center text-[13px] text-muted">暂无可统计的跟踪记录</p>
    ) : (
      <>
        <div class="mt-4 grid gap-3 sm:grid-cols-4">
          <div class="stat">
            <div class="k">样本数</div>
            <div class="v">{r.total}</div>
          </div>
          <div class="stat">
            <div class="k">命中 / 未命中</div>
            <div class="v flex items-baseline gap-2">
              <span class="text-up">{r.win}</span>
              <span class="text-muted">/</span>
              <span class="text-down">{r.loss}</span>
            </div>
          </div>
          <div class="stat">
            <div class="k">命中率</div>
            <div class="v">{rate.toFixed(1)}<span class="text-[16px] font-normal text-muted">%</span></div>
            <div class="bar-track mt-2">
              <div class="bar-fill bg-up" style={`width:${rate}%`}></div>
            </div>
          </div>
          <div class="stat">
            <div class="k">平均收益</div>
            <div class:list={['v', avgCls]}>
              {r.avgReturn >= 0 ? '+' : ''}{r.avgReturn.toFixed(2)}<span class="text-[16px] font-normal text-muted">%</span>
            </div>
          </div>
        </div>

        <div class="mt-4 flex flex-wrap gap-4 text-[12px] text-muted">
          <span>进行中 / 未结算：{pending}</span>
          <span>口径：按每篇复盘记录的跟踪状态结算，止损出局计未命中</span>
        </div>

        {r.note && <p class="mt-3 text-[13px] leading-6 text-slate-300">{r.note}</p>}
      </>
    )
  }
</section>
