---
import Freshness from './Freshness.astro';
import { ashare } from '../lib/data';
import { fmtNum, fmtPct, fmtSigned, dirClass, dirChip } from '../lib/format';

const d = ashare;
const b = d.breadth;
const totalBreadth = (b.up ?? 0) + (b.down ?? 0);
const upRatio = totalBreadth > 0 ? (b.up / totalBreadth) * 100 : 0;
---

<section class="panel-pad">
  <div class="sec-head">
    <span class="bar"></span>
    <span class="title">市场表现 · A股</span>
    <span class="meta flex items-center gap-2">
      <span class="chip">{d.batch}</span>
      <span class="label">抓取于 <Freshness iso={d.updatedAt} /></span>
    </span>
  </div>

  {
    d.stale || d.indices.length === 0 ? (
      <p class="note-warn mt-4">
        暂无真实数据。运行 <code class="text-gold">npm run fetch</code> 抓取最新延迟数据（或等待 GitHub Actions 定时更新）。
        本站不展示任何虚构行情。
      </p>
    ) : null
  }

  {
    d.indices.length === 0 ? (
      <p class="py-6 text-center text-[13px] text-muted">暂无指数数据</p>
    ) : (
      <div class="mt-4 overflow-x-auto">
        <table class="table-fin min-w-[560px]">
          <thead>
            <tr>
              <th>指数</th>
              <th class="num-col">收盘</th>
              <th class="num-col">涨跌</th>
              <th class="num-col">涨跌幅</th>
              <th class="num-col">成交额(亿)</th>
              <th class="num-col">振幅</th>
            </tr>
          </thead>
          <tbody>
            {
              d.indices.map((i) => (
                <tr>
                  <td>
                    <div class="text-slate-200">{i.name}</div>
                    <div class="num text-[11px] text-muted">{i.code}</div>
                  </td>
                  <td class:list={['num-col py-2.5 font-medium', dirClass(i.changePct)]}>{fmtNum(i.close)}</td>
                  <td class:list={['num-col', dirClass(i.changePct)]}>{fmtSigned(i.change)}</td>
                  <td class="num-col py-2.5">
                    <span class:list={[dirChip(i.changePct), 'num']}>{fmtPct(i.changePct)}</span>
                  </td>
                  <td class="num-col text-slate-300">{fmtNum(i.amount ?? 0, 0)}</td>
                  <td class="num-col text-muted">{i.amplitude ? `${i.amplitude.toFixed(2)}%` : '—'}</td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
    )
  }

  <!-- 宽度 / 量能 / 融资 -->
  <div class="mt-5 grid gap-3 sm:grid-cols-4">
    <div class="stat">
      <div class="k">涨跌家数</div>
      {
        totalBreadth === 0 ? (
          <div class="v text-muted">—</div>
        ) : (
          <>
            <div class="v flex items-baseline gap-2">
              <span class="text-up">{b.up}</span>
              <span class="text-muted">/</span>
              <span class="text-down">{b.down}</span>
            </div>
            <div class="bar-track mt-2">
              <div class="bar-fill bg-up" style={`width:${upRatio}%`} />
            </div>
            <div class="sub text-muted">平盘 {b.flat ?? 0}</div>
          </>
        )
      }
    </div>

    <div class="stat">
      <div class="k">涨停 / 跌停</div>
      {
        (b.total ?? 0) === 0 ? (
          <div class="v text-muted">—</div>
        ) : (
          <>
            <div class="v flex items-baseline gap-2">
              <span class="text-up">{b.limitUp}</span>
              <span class="text-muted">/</span>
              <span class="text-down">{b.limitDown}</span>
            </div>
            <div class="sub text-muted">全市场 {b.total ?? b.up + b.down + (b.flat ?? 0)} 只</div>
          </>
        )
      }
    </div>

    <div class="stat">
      <div class="k">两市成交</div>
      {
        d.volume.amount ? (
          <>
            <div class="v">{fmtNum(d.volume.amount, 0)} <span class="text-[14px] font-normal text-muted">亿</span></div>
            <div class:list={['sub', dirClass(d.volume.changePct)]}>
              环比 {fmtPct(d.volume.changePct)}
            </div>
          </>
        ) : (
          <div class="v text-muted">—</div>
        )
      }
    </div>

    <div class="stat">
      <div class="k">融资余额</div>
      <div class="v">
        {d.margin ? `${fmtNum(d.margin.balance, 0)}` : '—'} <span class="text-[14px] font-normal text-muted">亿</span>
      </div>
      <div class:list={['sub', d.margin ? dirClass(d.margin.change) : 'text-muted']}>
        {d.margin ? `环比 ${fmtSigned(d.margin.change, 0)} 亿` : '暂无数据'}
      </div>
    </div>
  </div>
</section>
