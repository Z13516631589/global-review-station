---
import Freshness from './Freshness.astro';
import { ashare } from '../lib/data';
import { fmtNum, fmtPct, fmtSigned, dirClass, dirChip } from '../lib/format';

const d = ashare;
const b = d.breadth;
---

<section class="panel-pad">
  <div class="flex flex-wrap items-baseline justify-between gap-2">
    <h2 class="h-sec">市场表现 · A股</h2>
    <div class="flex items-center gap-2">
      <span class="chip">{d.batch}</span>
      <span class="label">抓取于 <Freshness iso={d.updatedAt} /></span>
    </div>
  </div>

  {
    d.stale || d.indices.length === 0 ? (
      <p class="mt-3 rounded-lg border border-gold/30 bg-gold/10 px-3 py-2 text-[12px] leading-5 text-gold/90">
        暂无真实数据。运行 <code class="text-gold">npm run fetch</code> 抓取最新延迟数据（或等待 GitHub Actions 定时更新）。
        本站不展示任何虚构行情。
      </p>
    ) : null
  }

  {
    d.indices.length === 0 ? (
      <p class="py-6 text-center text-[13px] text-muted">暂无指数数据</p>
    ) : (
      <div class="mt-4 overflow-x-auto">
        <table class="w-full min-w-[560px] text-sm">
      <thead>
        <tr class="border-b border-ink-400 text-left text-[12px] text-muted">
          <th class="pb-2 font-medium">指数</th>
          <th class="pb-2 text-right font-medium">收盘</th>
          <th class="pb-2 text-right font-medium">涨跌</th>
          <th class="pb-2 text-right font-medium">涨跌幅</th>
          <th class="pb-2 text-right font-medium">成交额(亿)</th>
          <th class="pb-2 text-right font-medium">振幅</th>
        </tr>
      </thead>
      <tbody>
        {
          d.indices.map((i) => (
            <tr class="border-b border-ink-500/60 last:border-0 hover:bg-ink-600/40">
              <td class="py-2.5">
                <div class="text-slate-200">{i.name}</div>
                <div class="num text-[11px] text-muted">{i.code}</div>
              </td>
              <td class:list={['num py-2.5 text-right font-medium', dirClass(i.changePct)]}>
                {fmtNum(i.close)}
              </td>
              <td class:list={['num py-2.5 text-right', dirClass(i.changePct)]}>{fmtSigned(i.change)}</td>
              <td class="py-2.5 text-right">
                <span class:list={[dirChip(i.changePct), 'num']}>{fmtPct(i.changePct)}</span>
              </td>
              <td class="num py-2.5 text-right text-slate-300">{fmtNum(i.amount ?? 0, 0)}</td>
              <td class="num py-2.5 text-right text-muted">{i.amplitude ? `${i.amplitude.toFixed(2)}%` : '—'}</td>
            </tr>
          ))
        }
      </tbody>
        </table>
      </div>
    )
  }

  <!-- 宽度 / 量能 / 融资 -->
  <div class="mt-5 grid gap-3 sm:grid-cols-4">
    <div class="rounded-xl2 border border-ink-400/60 bg-ink-600/40 p-3">
      <div class="label">涨跌家数</div>
      {
        (b.up ?? 0) + (b.down ?? 0) === 0 ? (
          <div class="num mt-1 text-sm text-muted">—</div>
        ) : (
          <>
            <div class="mt-1 flex items-baseline gap-2 text-sm">
              <span class="num font-semibold text-up">{b.up}</span>
              <span class="text-muted">/</span>
              <span class="num font-semibold text-down">{b.down}</span>
            </div>
            <div class="mt-2 h-1.5 w-full overflow-hidden rounded-full bg-ink-500">
              <div
                class="h-full rounded-full"
                style={`width:${(b.up / Math.max(b.up + b.down, 1)) * 100}%;background:#f2385a`}
              />
            </div>
            <div class="mt-1.5 text-[12px] text-muted">平盘 {b.flat ?? 0}</div>
          </>
        )
      }
    </div>

    <div class="rounded-xl2 border border-ink-400/60 bg-ink-600/40 p-3">
      <div class="label">涨停 / 跌停</div>
      {
        (b.total ?? 0) === 0 ? (
          <div class="num mt-1 text-sm text-muted">—</div>
        ) : (
          <>
            <div class="mt-1 flex items-baseline gap-2 text-sm">
              <span class="num font-semibold text-up">{b.limitUp}</span>
              <span class="text-muted">/</span>
              <span class="num font-semibold text-down">{b.limitDown}</span>
            </div>
            <div class="mt-1.5 text-[12px] text-muted">全市场 {b.total ?? b.up + b.down + (b.flat ?? 0)} 只</div>
          </>
        )
      }
    </div>

    <div class="rounded-xl2 border border-ink-400/60 bg-ink-600/40 p-3">
      <div class="label">两市成交</div>
      {
        d.volume.amount ? (
          <>
            <div class="num mt-1 text-sm font-semibold text-slate-100">{fmtNum(d.volume.amount, 0)} 亿</div>
            <div class:list={['mt-1.5 num text-[12px]', dirClass(d.volume.changePct)]}>
              环比 {fmtPct(d.volume.changePct)}
            </div>
          </>
        ) : (
          <div class="num mt-1 text-sm text-muted">—</div>
        )
      }
    </div>

    <div class="rounded-xl2 border border-ink-400/60 bg-ink-600/40 p-3">
      <div class="label">融资余额</div>
      <div class="num mt-1 text-sm font-semibold text-slate-100">
        {d.margin ? `${fmtNum(d.margin.balance, 0)} 亿` : '—'}
      </div>
      <div class:list={['mt-1.5 num text-[12px]', d.margin ? dirClass(d.margin.change) : 'text-muted']}>
        {d.margin ? `环比 ${fmtSigned(d.margin.change, 0)} 亿` : '暂无数据'}
      </div>
    </div>
  </div>
</section>
