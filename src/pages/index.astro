---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import GlobalSnapshot from '../components/GlobalSnapshot.astro';
import MarketTable from '../components/MarketTable.astro';
import SectorBoard from '../components/SectorBoard.astro';
import NewsList from '../components/NewsList.astro';
import SentimentBar from '../components/SentimentBar.astro';
import { u } from '../lib/base';
import { fmtDate, weekdayCN } from '../lib/format';

const reviews = (await getCollection('reviews')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
const latest = reviews[0];
---

<Base title="环球复盘站 · 客观股市复盘">
  <div class="mx-auto max-w-6xl px-4 py-8">
    <!-- 最新复盘头图 -->
    {
      latest && (
        <section class="panel relative overflow-hidden p-5 sm:p-7">
          <div class="flex flex-wrap items-center gap-2">
            <span class="chip">{fmtDate(latest.data.date)} {weekdayCN(latest.data.date)}</span>
            <span class="chip">{latest.data.batch}</span>
            {latest.data.sample && <span class="chip border-gold/40 bg-gold/10 text-gold">示例复盘</span>}
            <span class="label">作者：{latest.data.author}</span>
          </div>
          <h1 class="mt-3 text-2xl font-semibold leading-9 tracking-tight text-slate-100 sm:text-3xl">
            <a href={u(`/reviews/${latest.id}`)} class="hover:text-accent">{latest.data.title}</a>
          </h1>
          <p class="mt-3 max-w-3xl text-[14px] leading-7 text-slate-300">{latest.data.summary}</p>
          <div class="mt-5 flex flex-wrap gap-3">
            <a href={u(`/reviews/${latest.id}`)} class="rounded-lg bg-accent px-4 py-2 text-sm font-medium text-white hover:bg-blue-500">
              阅读完整复盘
            </a>
            <a href={u("/reviews")} class="rounded-lg border border-ink-400 px-4 py-2 text-sm text-slate-300 hover:bg-ink-600">
              历史归档（{reviews.length} 篇）
            </a>
          </div>
        </section>
      )
    }

    {
      !latest && (
        <section class="panel-pad">
          <h1 class="text-xl font-semibold text-slate-100">还没有复盘</h1>
          <p class="mt-2 text-[14px] leading-7 text-slate-300">
            在 <code class="text-gold">src/content/reviews/</code> 下新建 <code class="text-gold">YYYY-MM-DD.mdx</code> 即可发布第一篇。
          </p>
        </section>
      )
    }

    <div class="mt-6 grid gap-6 lg:grid-cols-3">
      <div class="space-y-6 lg:col-span-2">
        <GlobalSnapshot limitGroups={2} title="全球市场 · 美股 / 中概" />
        <MarketTable />
      </div>
      <div class="space-y-6">
        <SentimentBar />
        <SectorBoard limit={6} />
      </div>
    </div>

    <div class="mt-6">
      <NewsList limit={5} title="消息面 · 最新 5 条（附影响分析）" />
    </div>

    <div class="mt-6 grid gap-6 sm:grid-cols-2">
      {
        reviews.slice(1, 5).map((r) => (
          <a href={u(`/reviews/${r.id}`)} class="panel block p-4 hover:border-accent/60">
            <div class="flex items-center gap-2">
              <span class="label">{fmtDate(r.data.date)}</span>
              <span class="chip">{r.data.batch}</span>
            </div>
            <div class="mt-2 text-[15px] font-medium leading-7 text-slate-100">{r.data.title}</div>
            <p class="mt-1.5 line-clamp-2 text-[13px] leading-6 text-muted">{r.data.summary}</p>
          </a>
        ))
      }
    </div>
  </div>
</Base>
