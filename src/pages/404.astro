---
import Base from '../layouts/Base.astro';
import { u } from '../lib/base';
---

<Base title="页面不存在 · 环球复盘站">
  <div class="mx-auto max-w-3xl px-4 py-20 text-center">
    <div class="num text-6xl font-semibold text-ink-400">404</div>
    <h1 class="mt-4 text-xl font-semibold text-slate-100">这个页面不存在</h1>
    <p class="mt-3 text-[14px] leading-7 text-muted">
      可能是复盘尚未发布，或链接已失效。
    </p>
    <div class="mt-6 flex justify-center gap-3">
      <a href={u("/")} class="rounded-lg bg-accent px-4 py-2 text-sm font-medium text-white hover:bg-blue-500">
        回到首页
      </a>
      <a href={u("/reviews")} class="rounded-lg border border-ink-400 px-4 py-2 text-sm text-slate-300 hover:bg-ink-600">
        查看复盘归档
      </a>
    </div>
  </div>
</Base>
